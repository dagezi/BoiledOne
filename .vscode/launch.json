{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "sweetpad-lldb",
            "request": "attach",
            "name": "SweetPad: Build and Run (Wait for debugger)",
            "preLaunchTask": "sweetpad: debugging-launch"
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/<your program>",
            "args": [],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb-dap",
            "request": "attach",
            "name": "Attach to BoiledOne.app",
            "program": "${workspaceFolder}/BoiledOne.app/Contents/MacOS/BoiledOne",
            "waitFor": true
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:BoiledOne}",
            "name": "Debug BoiledOne",
            "target": "BoiledOne",
            "configuration": "debug",
            "preLaunchTask": "swift: Build Debug BoiledOne"
        },
        {
            "type": "swift",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder:BoiledOne}",
            "name": "Release BoiledOne",
            "target": "BoiledOne",
            "configuration": "release",
            "preLaunchTask": "swift: Build Release BoiledOne"
        }
    ]
}